# Copie este ficheiro para ".env.local" (que NUNCA deve ser commitado) e
# preencha com os dados do seu projeto Supabase:
#
#   1. Entre em https://app.supabase.com e abra o seu projeto
#      (ou crie um novo, é grátis).
#   2. Vá a Project Settings -> Data API / API Keys.
#   3. "Project URL" -> VITE_SUPABASE_URL
#      "anon public" key -> VITE_SUPABASE_ANON_KEY
#
# Sem estes valores, o app funciona normalmente com os dados de demonstração
# em memória (não fica gravado nada, mas nada quebra).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
